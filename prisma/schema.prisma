// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Pishnam domain ──

model GiftOrder {
  id         String   @id // client-side id (g-<no>-<ts>) keeps local↔server identity
  no         Int      @unique
  kind       String
  to         String
  city       String   @default("")
  address    String   @default("")
  phone      String   @default("")
  message    String   @default("")
  occasion   Int      @default(0)
  password   String   @default("")
  anonymous  Boolean  @default(false)
  senderName String   @default("")
  hearts     Int      @default(0)
  paws       Int      @default(0)
  total      Int      @default(0)
  date       String   @default("")
  status     String   @default("paid") // paid | packing | shipped | delivered
  opened     Boolean  @default(false)
  dir        String   @default("sent") // sent | recv
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  orderNo   String   @default("")
  message   String
  createdAt DateTime @default(now())
}
