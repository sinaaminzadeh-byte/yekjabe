// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Pishnam domain ──

model GiftOrder {
  id         String   @id // client-side id (g-<no>-<ts>) keeps local↔server identity
  no         Int      @unique
  kind       String
  to         String
  city       String   @default("")
  address    String   @default("")
  phone      String   @default("")
  message    String   @default("")
  occasion   Int      @default(0)
  password   String   @default("")
  anonymous  Boolean  @default(false)
  senderName String   @default("")
  hearts     Int      @default(0)
  paws       Int      @default(0)
  total      Int      @default(0)
  date       String   @default("")
  status     String   @default("paid") // paid | packing | shipped | delivered
  opened     Boolean  @default(false)
  dir        String   @default("sent") // sent | recv
  userPhone  String   @default("") // phone of the logged-in sender (empty = guest)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userPhone])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  orderNo   String   @default("")
  message   String
  createdAt DateTime @default(now())
}

// ── Auth (demo OTP flow) ──

model AppUser {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime @default(now())
}

model AuthCode {
  id        String   @id @default(cuid())
  phone     String
  code      String   @default("") // legacy demo field (pre-hardening rows)
  codeHash  String   @default("") // HMAC-SHA256(phone:code, SESSION_SECRET)
  attempts  Int      @default(0)
  ip        String   @default("")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// ── DB-backed sessions (Phase A — guide §4.2) ──

model Session {
  id         String   @id // sha256(token) — the raw token only lives in the cookie
  phone      String
  kind       String   @default("customer") // customer | admin
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// ── Admin users (2 seats max — owner | operator) ──

model AdminUser {
  id          String    @id @default(cuid())
  phone       String    @unique
  name        String    @default("")
  role        String    @default("operator") // owner | operator
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
}

// ── Per-account favorites (پشمالوهای محبوب) ──

model Favorite {
  id        String   @id @default(cuid())
  userPhone String
  kind      String // PlushKind
  createdAt DateTime @default(now())

  @@unique([userPhone, kind])
  @@index([userPhone])
}

// ── Real customer reviews (نظرهای واقعی) ──

model Review {
  id        String   @id @default(cuid())
  who       String // display name
  role      String   @default("sender") // sender | receiver
  stars     Int      @default(5) // 1..5
  kind      String   @default("bear") // PlushKind of the gift
  title     String   @default("")
  text      String
  approved  Boolean  @default(false) // moderation gate (Phase A — guide A9)
  createdAt DateTime @default(now())
}
