{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yekjabe",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding (OpenNext requirement) — also used by
      // cloudflare-worker.ts scheduled() to reach /api/jobs/* internally.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yekjabe"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "30 0 * * *"
    ]
  },
  "vars": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "INTERNAL_CRON": "0",
    "SMS_DEV_ECHO": "0",
    "ZARINPAL_SANDBOX": "0"
  }
}
